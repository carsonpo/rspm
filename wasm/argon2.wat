    ;; G0(v0, v4, v8, v12)
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v4)) (i64.load offset=64 (i32.load8_u offset=0 (local.get $s)))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v0)) (i64.const 32)))
    (local.set $v8 (i64.add (local.get $v8) (local.get $v12)))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v8)) (i64.const 24)))
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v4)) (i64.load offset=64 (i32.load8_u offset=1 (local.get $s)))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v0)) (i64.const 16)))
    (local.set $v8 (i64.add (local.get $v8) (local.get $v12)))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v8)) (i64.const 63)))
    ;; G1(v1, v5, v9, v13)
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v5)) (i64.load offset=64 (i32.load8_u offset=2 (local.get $s)))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v1)) (i64.const 32)))
    (local.set $v9 (i64.add (local.get $v9) (local.get $v13)))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v9)) (i64.const 24)))
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v5)) (i64.load offset=64 (i32.load8_u offset=3 (local.get $s)))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v1)) (i64.const 16)))
    (local.set $v9 (i64.add (local.get $v9) (local.get $v13)))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v9)) (i64.const 63)))
    ;; G2(v2, v6, v10, v14)
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v6)) (i64.load offset=64 (i32.load8_u offset=4 (local.get $s)))))
    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v2)) (i64.const 32)))
    (local.set $v10 (i64.add (local.get $v10) (local.get $v14)))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v10)) (i64.const 24)))
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v6)) (i64.load offset=64 (i32.load8_u offset=5 (local.get $s)))))
    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v2)) (i64.const 16)))
    (local.set $v10 (i64.add (local.get $v10) (local.get $v14)))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v10)) (i64.const 63)))
    ;; G3(v3, v7, v11, v15)
    (local.set $v3 (i64.add (i64.add (local.get $v3) (local.get $v7)) (i64.load offset=64 (i32.load8_u offset=6 (local.get $s)))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v3)) (i64.const 32)))
    (local.set $v11 (i64.add (local.get $v11) (local.get $v15)))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v11)) (i64.const 24)))
    (local.set $v3 (i64.add (i64.add (local.get $v3) (local.get $v7)) (i64.load offset=64 (i32.load8_u offset=7 (local.get $s)))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v3)) (i64.const 16)))
    (local.set $v11 (i64.add (local.get $v11) (local.get $v15)))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v11)) (i64.const 63)))
    ;; G4(v0, v5, v10, v15)
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v5)) (i64.load offset=64 (i32.load8_u offset=8 (local.get $s)))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v0)) (i64.const 32)))
    (local.set $v10 (i64.add (local.get $v10) (local.get $v15)))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v10)) (i64.const 24)))
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v5)) (i64.load offset=64 (i32.load8_u offset=9 (local.get $s)))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v0)) (i64.const 16)))
    (local.set $v10 (i64.add (local.get $v10) (local.get $v15)))
