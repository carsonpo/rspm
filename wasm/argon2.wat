;;    2048  Argon2 T = R (⊕ old block)              1024 B
;;    3072  one gathered column for P                128 B
;;    3200  H0 ‖ LE32(j) ‖ LE32(lane)                 72 B   (H0 written by the caller)
;;    4096  address block                           1024 B
;;    5120  address input block Z                   1024 B
;;    6144  zero block (never written)              1024 B
;;    7168  final block C                           1024 B
;;    8192  I/O area for the caller                57344 B
