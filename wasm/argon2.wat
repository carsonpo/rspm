    ;; G6(v2, v7, v8, v13)
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v7)) (i64.load offset=64 (i32.load8_u offset=12 (local.get $s)))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v2)) (i64.const 32)))
    (local.set $v8 (i64.add (local.get $v8) (local.get $v13)))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v8)) (i64.const 24)))
