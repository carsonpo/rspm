  ;; Absorbs $len bytes at $ptr. The last block is always kept for $b2_final.
  (func $b2_update (export "b2_update") (param $ptr i32) (param $len i32)
    (local $n i32)
    (block $done (loop $more
      (br_if $done (i32.eqz (local.get $len)))
      (if (i32.eq (global.get $buflen) (i32.const 128)) (then
        (global.set $t (i64.add (global.get $t) (i64.const 128)))
        (call $b2_compress (i32.const 0))
        (global.set $buflen (i32.const 0))))
      (local.set $n (i32.sub (i32.const 128) (global.get $buflen)))
      (local.set $n (select (local.get $len) (local.get $n) (i32.lt_u (local.get $len) (local.get $n))))
      (memory.copy (i32.add (i32.const 64) (global.get $buflen)) (local.get $ptr) (local.get $n))
      (global.set $buflen (i32.add (global.get $buflen) (local.get $n)))
      (local.set $ptr (i32.add (local.get $ptr) (local.get $n)))
      (local.set $len (i32.sub (local.get $len) (local.get $n)))
      (br $more))))

  ;; Finishes the hash and writes $outlen bytes to $out.
  (func $b2_final (export "b2_final") (param $out i32)
    (global.set $t (i64.add (global.get $t) (i64.extend_i32_u (global.get $buflen))))
    (memory.fill (i32.add (i32.const 64) (global.get $buflen)) (i32.const 0)
      (i32.sub (i32.const 128) (global.get $buflen)))
    (call $b2_compress (i32.const 1))
    (memory.copy (local.get $out) (i32.const 0) (global.get $outlen)))

  ;; Variable-length hash H' (RFC 9106 §3.3): $T bytes of H'(X) to $out.
  (func $hprime (param $in i32) (param $len i32) (param $out i32) (param $T i32)
    (local $rem i32)
    (call $b2_init (select (local.get $T) (i32.const 64) (i32.le_u (local.get $T) (i32.const 64)))
      (i32.const 0) (i32.const 0))
    (i32.store offset=512 (i32.const 0) (local.get $T))
    (call $b2_update (i32.const 512) (i32.const 4))
    (call $b2_update (local.get $in) (local.get $len))
    (if (i32.le_u (local.get $T) (i32.const 64)) (then
      (call $b2_final (local.get $out))
      (return)))
    ;; V1 = H^64(LE32(T) ‖ X); emit 32 bytes of each V_i, then the whole V_{r+1}.
    (call $b2_final (i32.const 192))
    (memory.copy (local.get $out) (i32.const 192) (i32.const 32))
    (local.set $out (i32.add (local.get $out) (i32.const 32)))
    (local.set $rem (i32.sub (local.get $T) (i32.const 32)))
    (block $done (loop $more
      (br_if $done (i32.le_u (local.get $rem) (i32.const 64)))
      (call $b2_init (i32.const 64) (i32.const 0) (i32.const 0))
      (call $b2_update (i32.const 192) (i32.const 64))
      (call $b2_final (i32.const 192))
      (memory.copy (local.get $out) (i32.const 192) (i32.const 32))
      (local.set $out (i32.add (local.get $out) (i32.const 32)))
      (local.set $rem (i32.sub (local.get $rem) (i32.const 32)))
      (br $more)))
    (call $b2_init (local.get $rem) (i32.const 0) (i32.const 0))
    (call $b2_update (i32.const 192) (i32.const 64))
    (call $b2_final (local.get $out)))

  ;; ── Argon2 ───────────────────────────────────────────────────────────────

  ;; Argon2 permutation P (RFC 9106 §3.6) on 16 contiguous words at $p, in place.
  (func $P (param $p i32)
    (local $v0 i64) (local $v1 i64) (local $v2 i64) (local $v3 i64) (local $v4 i64) (local $v5 i64) (local $v6 i64) (local $v7 i64) (local $v8 i64) (local $v9 i64) (local $v10 i64) (local $v11 i64) (local $v12 i64) (local $v13 i64) (local $v14 i64) (local $v15 i64)
    (local.set $v0 (i64.load offset=0 (local.get $p)))
    (local.set $v1 (i64.load offset=8 (local.get $p)))
    (local.set $v2 (i64.load offset=16 (local.get $p)))
    (local.set $v3 (i64.load offset=24 (local.get $p)))
    (local.set $v4 (i64.load offset=32 (local.get $p)))
    (local.set $v5 (i64.load offset=40 (local.get $p)))
    (local.set $v6 (i64.load offset=48 (local.get $p)))
    (local.set $v7 (i64.load offset=56 (local.get $p)))
    (local.set $v8 (i64.load offset=64 (local.get $p)))
    (local.set $v9 (i64.load offset=72 (local.get $p)))
    (local.set $v10 (i64.load offset=80 (local.get $p)))
    (local.set $v11 (i64.load offset=88 (local.get $p)))
    (local.set $v12 (i64.load offset=96 (local.get $p)))
    (local.set $v13 (i64.load offset=104 (local.get $p)))
    (local.set $v14 (i64.load offset=112 (local.get $p)))
    (local.set $v15 (i64.load offset=120 (local.get $p)))
    ;; GB(v0, v4, v8, v12)
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v4)) (i64.shl (i64.mul (i64.and (local.get $v0) (i64.const 0xffffffff)) (i64.and (local.get $v4) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v0)) (i64.const 32)))
    (local.set $v8 (i64.add (i64.add (local.get $v8) (local.get $v12)) (i64.shl (i64.mul (i64.and (local.get $v8) (i64.const 0xffffffff)) (i64.and (local.get $v12) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v8)) (i64.const 24)))
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v4)) (i64.shl (i64.mul (i64.and (local.get $v0) (i64.const 0xffffffff)) (i64.and (local.get $v4) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v0)) (i64.const 16)))
    (local.set $v8 (i64.add (i64.add (local.get $v8) (local.get $v12)) (i64.shl (i64.mul (i64.and (local.get $v8) (i64.const 0xffffffff)) (i64.and (local.get $v12) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v8)) (i64.const 63)))
    ;; GB(v1, v5, v9, v13)
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v5)) (i64.shl (i64.mul (i64.and (local.get $v1) (i64.const 0xffffffff)) (i64.and (local.get $v5) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v1)) (i64.const 32)))
    (local.set $v9 (i64.add (i64.add (local.get $v9) (local.get $v13)) (i64.shl (i64.mul (i64.and (local.get $v9) (i64.const 0xffffffff)) (i64.and (local.get $v13) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v9)) (i64.const 24)))
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v5)) (i64.shl (i64.mul (i64.and (local.get $v1) (i64.const 0xffffffff)) (i64.and (local.get $v5) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v1)) (i64.const 16)))
    (local.set $v9 (i64.add (i64.add (local.get $v9) (local.get $v13)) (i64.shl (i64.mul (i64.and (local.get $v9) (i64.const 0xffffffff)) (i64.and (local.get $v13) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v9)) (i64.const 63)))
    ;; GB(v2, v6, v10, v14)
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v6)) (i64.shl (i64.mul (i64.and (local.get $v2) (i64.const 0xffffffff)) (i64.and (local.get $v6) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v2)) (i64.const 32)))
    (local.set $v10 (i64.add (i64.add (local.get $v10) (local.get $v14)) (i64.shl (i64.mul (i64.and (local.get $v10) (i64.const 0xffffffff)) (i64.and (local.get $v14) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v10)) (i64.const 24)))
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v6)) (i64.shl (i64.mul (i64.and (local.get $v2) (i64.const 0xffffffff)) (i64.and (local.get $v6) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v2)) (i64.const 16)))
    (local.set $v10 (i64.add (i64.add (local.get $v10) (local.get $v14)) (i64.shl (i64.mul (i64.and (local.get $v10) (i64.const 0xffffffff)) (i64.and (local.get $v14) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v10)) (i64.const 63)))
    ;; GB(v3, v7, v11, v15)
    (local.set $v3 (i64.add (i64.add (local.get $v3) (local.get $v7)) (i64.shl (i64.mul (i64.and (local.get $v3) (i64.const 0xffffffff)) (i64.and (local.get $v7) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v3)) (i64.const 32)))
    (local.set $v11 (i64.add (i64.add (local.get $v11) (local.get $v15)) (i64.shl (i64.mul (i64.and (local.get $v11) (i64.const 0xffffffff)) (i64.and (local.get $v15) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v11)) (i64.const 24)))
    (local.set $v3 (i64.add (i64.add (local.get $v3) (local.get $v7)) (i64.shl (i64.mul (i64.and (local.get $v3) (i64.const 0xffffffff)) (i64.and (local.get $v7) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v3)) (i64.const 16)))
    (local.set $v11 (i64.add (i64.add (local.get $v11) (local.get $v15)) (i64.shl (i64.mul (i64.and (local.get $v11) (i64.const 0xffffffff)) (i64.and (local.get $v15) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v11)) (i64.const 63)))
    ;; GB(v0, v5, v10, v15)
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v5)) (i64.shl (i64.mul (i64.and (local.get $v0) (i64.const 0xffffffff)) (i64.and (local.get $v5) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v0)) (i64.const 32)))
    (local.set $v10 (i64.add (i64.add (local.get $v10) (local.get $v15)) (i64.shl (i64.mul (i64.and (local.get $v10) (i64.const 0xffffffff)) (i64.and (local.get $v15) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v10)) (i64.const 24)))
    (local.set $v0 (i64.add (i64.add (local.get $v0) (local.get $v5)) (i64.shl (i64.mul (i64.and (local.get $v0) (i64.const 0xffffffff)) (i64.and (local.get $v5) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v15 (i64.rotr (i64.xor (local.get $v15) (local.get $v0)) (i64.const 16)))
    (local.set $v10 (i64.add (i64.add (local.get $v10) (local.get $v15)) (i64.shl (i64.mul (i64.and (local.get $v10) (i64.const 0xffffffff)) (i64.and (local.get $v15) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v5 (i64.rotr (i64.xor (local.get $v5) (local.get $v10)) (i64.const 63)))
    ;; GB(v1, v6, v11, v12)
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v6)) (i64.shl (i64.mul (i64.and (local.get $v1) (i64.const 0xffffffff)) (i64.and (local.get $v6) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v1)) (i64.const 32)))
    (local.set $v11 (i64.add (i64.add (local.get $v11) (local.get $v12)) (i64.shl (i64.mul (i64.and (local.get $v11) (i64.const 0xffffffff)) (i64.and (local.get $v12) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v11)) (i64.const 24)))
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v6)) (i64.shl (i64.mul (i64.and (local.get $v1) (i64.const 0xffffffff)) (i64.and (local.get $v6) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v1)) (i64.const 16)))
    (local.set $v11 (i64.add (i64.add (local.get $v11) (local.get $v12)) (i64.shl (i64.mul (i64.and (local.get $v11) (i64.const 0xffffffff)) (i64.and (local.get $v12) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v11)) (i64.const 63)))
    ;; GB(v2, v7, v8, v13)
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v7)) (i64.shl (i64.mul (i64.and (local.get $v2) (i64.const 0xffffffff)) (i64.and (local.get $v7) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v2)) (i64.const 32)))
    (local.set $v8 (i64.add (i64.add (local.get $v8) (local.get $v13)) (i64.shl (i64.mul (i64.and (local.get $v8) (i64.const 0xffffffff)) (i64.and (local.get $v13) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v8)) (i64.const 24)))
    (local.set $v2 (i64.add (i64.add (local.get $v2) (local.get $v7)) (i64.shl (i64.mul (i64.and (local.get $v2) (i64.const 0xffffffff)) (i64.and (local.get $v7) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v13 (i64.rotr (i64.xor (local.get $v13) (local.get $v2)) (i64.const 16)))
    (local.set $v8 (i64.add (i64.add (local.get $v8) (local.get $v13)) (i64.shl (i64.mul (i64.and (local.get $v8) (i64.const 0xffffffff)) (i64.and (local.get $v13) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v7 (i64.rotr (i64.xor (local.get $v7) (local.get $v8)) (i64.const 63)))
    ;; GB(v3, v4, v9, v14)
