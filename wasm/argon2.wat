    (local.set $v11 (i64.add (local.get $v11) (local.get $v12)))
    (local.set $v6 (i64.rotr (i64.xor (local.get $v6) (local.get $v11)) (i64.const 24)))
    (local.set $v1 (i64.add (i64.add (local.get $v1) (local.get $v6)) (i64.load offset=64 (i32.load8_u offset=11 (local.get $s)))))
    (local.set $v12 (i64.rotr (i64.xor (local.get $v12) (local.get $v1)) (i64.const 16)))
    (local.set $v11 (i64.add (local.get $v11) (local.get $v12)))
