    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v3)) (i64.const 32)))
    (local.set $v9 (i64.add (i64.add (local.get $v9) (local.get $v14)) (i64.shl (i64.mul (i64.and (local.get $v9) (i64.const 0xffffffff)) (i64.and (local.get $v14) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v9)) (i64.const 24)))
    (local.set $v3 (i64.add (i64.add (local.get $v3) (local.get $v4)) (i64.shl (i64.mul (i64.and (local.get $v3) (i64.const 0xffffffff)) (i64.and (local.get $v4) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v14 (i64.rotr (i64.xor (local.get $v14) (local.get $v3)) (i64.const 16)))
    (local.set $v9 (i64.add (i64.add (local.get $v9) (local.get $v14)) (i64.shl (i64.mul (i64.and (local.get $v9) (i64.const 0xffffffff)) (i64.and (local.get $v14) (i64.const 0xffffffff))) (i64.const 1))))
    (local.set $v4 (i64.rotr (i64.xor (local.get $v4) (local.get $v9)) (i64.const 63)))
    (i64.store offset=0 (local.get $p) (local.get $v0))
    (i64.store offset=8 (local.get $p) (local.get $v1))
    (i64.store offset=16 (local.get $p) (local.get $v2))
    (i64.store offset=24 (local.get $p) (local.get $v3))
    (i64.store offset=32 (local.get $p) (local.get $v4))
    (i64.store offset=40 (local.get $p) (local.get $v5))
    (i64.store offset=48 (local.get $p) (local.get $v6))
    (i64.store offset=56 (local.get $p) (local.get $v7))
    (i64.store offset=64 (local.get $p) (local.get $v8))
    (i64.store offset=72 (local.get $p) (local.get $v9))
    (i64.store offset=80 (local.get $p) (local.get $v10))
    (i64.store offset=88 (local.get $p) (local.get $v11))
    (i64.store offset=96 (local.get $p) (local.get $v12))
    (i64.store offset=104 (local.get $p) (local.get $v13))
    (i64.store offset=112 (local.get $p) (local.get $v14))
    (i64.store offset=120 (local.get $p) (local.get $v15))
