  ;; Compression G (RFC 9106 §3.5): $next = P(X ⊕ Y) ⊕ (X ⊕ Y) [⊕ $next if $xor].
  ;; $next may alias $ref; both inputs are fully read before $next is written.
  (func $fill_block (param $prev i32) (param $ref i32) (param $next i32) (param $xor i32)
    (local $o i32) (local $r i64) (local $c i32)
    (loop $copy
      (local.set $r (i64.xor (i64.load (i32.add (local.get $prev) (local.get $o)))
                             (i64.load (i32.add (local.get $ref) (local.get $o)))))
      (i64.store offset=1024 (local.get $o) (local.get $r))
      (i64.store offset=2048 (local.get $o)
        (select (i64.xor (local.get $r) (i64.load (i32.add (local.get $next) (local.get $o))))
                (local.get $r) (local.get $xor)))
      (local.set $o (i32.add (local.get $o) (i32.const 8)))
      (br_if $copy (i32.lt_u (local.get $o) (i32.const 1024))))
    ;; Rows: 8 × P over 16 contiguous words.
    (local.set $c (i32.const 1024))
    (loop $rows
      (call $P (local.get $c))
      (local.set $c (i32.add (local.get $c) (i32.const 128)))
      (br_if $rows (i32.lt_u (local.get $c) (i32.const 2048))))
    ;; Columns: column i is words 2i, 2i+1 of every row; gather, permute, scatter.
    (local.set $c (i32.const 1024))
    (loop $cols
        (i64.store offset=3072 (i32.const 0) (i64.load offset=0 (local.get $c)))
        (i64.store offset=3080 (i32.const 0) (i64.load offset=8 (local.get $c)))
        (i64.store offset=3088 (i32.const 0) (i64.load offset=128 (local.get $c)))
        (i64.store offset=3096 (i32.const 0) (i64.load offset=136 (local.get $c)))
        (i64.store offset=3104 (i32.const 0) (i64.load offset=256 (local.get $c)))
        (i64.store offset=3112 (i32.const 0) (i64.load offset=264 (local.get $c)))
        (i64.store offset=3120 (i32.const 0) (i64.load offset=384 (local.get $c)))
        (i64.store offset=3128 (i32.const 0) (i64.load offset=392 (local.get $c)))
        (i64.store offset=3136 (i32.const 0) (i64.load offset=512 (local.get $c)))
        (i64.store offset=3144 (i32.const 0) (i64.load offset=520 (local.get $c)))
        (i64.store offset=3152 (i32.const 0) (i64.load offset=640 (local.get $c)))
        (i64.store offset=3160 (i32.const 0) (i64.load offset=648 (local.get $c)))
        (i64.store offset=3168 (i32.const 0) (i64.load offset=768 (local.get $c)))
        (i64.store offset=3176 (i32.const 0) (i64.load offset=776 (local.get $c)))
        (i64.store offset=3184 (i32.const 0) (i64.load offset=896 (local.get $c)))
        (i64.store offset=3192 (i32.const 0) (i64.load offset=904 (local.get $c)))
      (call $P (i32.const 3072))
        (i64.store offset=0 (local.get $c) (i64.load offset=3072 (i32.const 0)))
        (i64.store offset=8 (local.get $c) (i64.load offset=3080 (i32.const 0)))
        (i64.store offset=128 (local.get $c) (i64.load offset=3088 (i32.const 0)))
        (i64.store offset=136 (local.get $c) (i64.load offset=3096 (i32.const 0)))
        (i64.store offset=256 (local.get $c) (i64.load offset=3104 (i32.const 0)))
        (i64.store offset=264 (local.get $c) (i64.load offset=3112 (i32.const 0)))
        (i64.store offset=384 (local.get $c) (i64.load offset=3120 (i32.const 0)))
        (i64.store offset=392 (local.get $c) (i64.load offset=3128 (i32.const 0)))
        (i64.store offset=512 (local.get $c) (i64.load offset=3136 (i32.const 0)))
        (i64.store offset=520 (local.get $c) (i64.load offset=3144 (i32.const 0)))
        (i64.store offset=640 (local.get $c) (i64.load offset=3152 (i32.const 0)))
        (i64.store offset=648 (local.get $c) (i64.load offset=3160 (i32.const 0)))
        (i64.store offset=768 (local.get $c) (i64.load offset=3168 (i32.const 0)))
        (i64.store offset=776 (local.get $c) (i64.load offset=3176 (i32.const 0)))
        (i64.store offset=896 (local.get $c) (i64.load offset=3184 (i32.const 0)))
        (i64.store offset=904 (local.get $c) (i64.load offset=3192 (i32.const 0)))
      (local.set $c (i32.add (local.get $c) (i32.const 16)))
      (br_if $cols (i32.lt_u (local.get $c) (i32.const 1152))))
    (local.set $o (i32.const 0))
    (loop $out
      (i64.store (i32.add (local.get $next) (local.get $o))
        (i64.xor (i64.load offset=2048 (local.get $o)) (i64.load offset=1024 (local.get $o))))
      (local.set $o (i32.add (local.get $o) (i32.const 8)))
      (br_if $out (i32.lt_u (local.get $o) (i32.const 1024)))))

  (func $blk (param $j i32) (result i32)
    (i32.add (i32.const 65536) (i32.shl (local.get $j) (i32.const 10))))

  ;; Next block of 128 data-independent addresses: G(0, G(0, Z)) after Z.counter++.
  (func $next_addresses
    (i64.store offset=5168 (i32.const 0) (i64.add (i64.load offset=5168 (i32.const 0)) (i64.const 1)))
    (call $fill_block (i32.const 6144) (i32.const 5120) (i32.const 4096) (i32.const 0))
    (call $fill_block (i32.const 6144) (i32.const 4096) (i32.const 4096) (i32.const 0)))

  ;; Fills one segment (RFC 9106 §3.4): pass $r, slice $s, lane $l.
  (func $fill_segment (param $r i32) (param $s i32) (param $l i32) (param $mp i32) (param $t i32)
                      (param $p i32) (param $q i32) (param $seg i32)
    (local $i i32) (local $curr i32) (local $prev i32) (local $di i32) (local $first i32)
    (local $pr i64) (local $rl i32) (local $area i64) (local $x i64) (local $start i64) (local $ref i32)
    ;; Argon2id: data-independent addressing in the first half of the first pass.
    (local.set $di (i32.and (i32.eqz (local.get $r)) (i32.lt_u (local.get $s) (i32.const 2))))
    (local.set $first (i32.and (i32.eqz (local.get $r)) (i32.eqz (local.get $s))))
    (if (local.get $di) (then
      (memory.fill (i32.const 5120) (i32.const 0) (i32.const 1024))
      (i64.store offset=5120 (i32.const 0) (i64.extend_i32_u (local.get $r)))
      (i64.store offset=5128 (i32.const 0) (i64.extend_i32_u (local.get $l)))
      (i64.store offset=5136 (i32.const 0) (i64.extend_i32_u (local.get $s)))
      (i64.store offset=5144 (i32.const 0) (i64.extend_i32_u (local.get $mp)))
      (i64.store offset=5152 (i32.const 0) (i64.extend_i32_u (local.get $t)))
      (i64.store offset=5160 (i32.const 0) (i64.const 2))))
    ;; Blocks 0 and 1 of each lane already exist; the loop starts at 2 and
    ;; would skip the i % 128 == 0 refill, so generate addresses up front.
    (if (local.get $first) (then
      (local.set $i (i32.const 2))
      (call $next_addresses)))
    (block $done (loop $each
      (br_if $done (i32.ge_u (local.get $i) (local.get $seg)))
      (local.set $curr (i32.add (i32.mul (local.get $l) (local.get $q))
        (i32.add (i32.mul (local.get $s) (local.get $seg)) (local.get $i))))
      (local.set $prev (select
        (i32.add (local.get $curr) (i32.sub (local.get $q) (i32.const 1)))
        (i32.sub (local.get $curr) (i32.const 1))
        (i32.eqz (i32.rem_u (local.get $curr) (local.get $q)))))
      (if (local.get $di)
        (then
          (if (i32.eqz (i32.and (local.get $i) (i32.const 127))) (then (call $next_addresses)))
          (local.set $pr (i64.load offset=4096 (i32.shl (i32.and (local.get $i) (i32.const 127)) (i32.const 3)))))
        (else
          (local.set $pr (i64.load (call $blk (local.get $prev))))))
      ;; Reference lane: J2 mod p, except the first slice of the first pass.
      (local.set $rl (select (local.get $l)
        (i32.wrap_i64 (i64.rem_u (i64.shr_u (local.get $pr) (i64.const 32)) (i64.extend_i32_u (local.get $p))))
        (local.get $first)))
      ;; Size of the referenceable area.
      (local.set $area (i64.extend_i32_u
        (if (result i32) (i32.eqz (local.get $r))
          (then
            (if (result i32) (i32.eqz (local.get $s))
              (then (i32.sub (local.get $i) (i32.const 1)))
              (else
                (if (result i32) (i32.eq (local.get $rl) (local.get $l))
                  (then (i32.sub (i32.add (i32.mul (local.get $s) (local.get $seg)) (local.get $i)) (i32.const 1)))
                  (else (i32.sub (i32.mul (local.get $s) (local.get $seg)) (i32.eqz (local.get $i))))))))
          (else
            (if (result i32) (i32.eq (local.get $rl) (local.get $l))
              (then (i32.sub (i32.add (i32.sub (local.get $q) (local.get $seg)) (local.get $i)) (i32.const 1)))
              (else (i32.sub (i32.sub (local.get $q) (local.get $seg)) (i32.eqz (local.get $i)))))))))
      ;; Map J1 non-uniformly onto the area (RFC 9106 §3.4.2).
      (local.set $x (i64.and (local.get $pr) (i64.const 0xffffffff)))
      (local.set $x (i64.shr_u (i64.mul (local.get $x) (local.get $x)) (i64.const 32)))
      (local.set $x (i64.sub (i64.sub (local.get $area) (i64.const 1))
        (i64.shr_u (i64.mul (local.get $area) (local.get $x)) (i64.const 32))))
      (local.set $start (select
        (i64.extend_i32_u (i32.mul (i32.add (local.get $s) (i32.const 1)) (local.get $seg)))
        (i64.const 0)
        (i32.and (i32.ne (local.get $r) (i32.const 0)) (i32.ne (local.get $s) (i32.const 3)))))
      (local.set $ref (i32.add (i32.mul (local.get $rl) (local.get $q))
        (i32.wrap_i64 (i64.rem_u (i64.add (local.get $start) (local.get $x)) (i64.extend_i32_u (local.get $q))))))
      ;; v1.3: passes after the first XOR into the existing block.
      (call $fill_block (call $blk (local.get $prev)) (call $blk (local.get $ref)) (call $blk (local.get $curr))
        (i32.ne (local.get $r) (i32.const 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $each))))

  ;; Argon2 with H0 already at 3200. $mp = m' blocks, $T-byte tag written to 8192.
  (func (export "argon2") (param $mp i32) (param $t i32) (param $p i32) (param $T i32)
    (local $q i32) (local $seg i32) (local $l i32) (local $r i32) (local $s i32) (local $o i32) (local $b i32)
    (local.set $q (i32.div_u (local.get $mp) (local.get $p)))
    (local.set $seg (i32.shr_u (local.get $q) (i32.const 2)))
    ;; B[l][0] = H'(H0 ‖ LE32(0) ‖ LE32(l)), B[l][1] = H'(H0 ‖ LE32(1) ‖ LE32(l))
    (loop $lanes
      (i32.store offset=3268 (i32.const 0) (local.get $l))
      (i32.store offset=3264 (i32.const 0) (i32.const 0))
      (call $hprime (i32.const 3200) (i32.const 72)
        (call $blk (i32.mul (local.get $l) (local.get $q))) (i32.const 1024))
      (i32.store offset=3264 (i32.const 0) (i32.const 1))
      (call $hprime (i32.const 3200) (i32.const 72)
        (call $blk (i32.add (i32.mul (local.get $l) (local.get $q)) (i32.const 1))) (i32.const 1024))
      (local.set $l (i32.add (local.get $l) (i32.const 1)))
      (br_if $lanes (i32.lt_u (local.get $l) (local.get $p))))
    ;; Passes × slices × lanes. Lanes run sequentially; within a slice they are independent.
    (loop $passes
      (local.set $s (i32.const 0))
      (loop $slices
        (local.set $l (i32.const 0))
        (loop $lanes2
          (call $fill_segment (local.get $r) (local.get $s) (local.get $l) (local.get $mp)
            (local.get $t) (local.get $p) (local.get $q) (local.get $seg))
          (local.set $l (i32.add (local.get $l) (i32.const 1)))
          (br_if $lanes2 (i32.lt_u (local.get $l) (local.get $p))))
        (local.set $s (i32.add (local.get $s) (i32.const 1)))
        (br_if $slices (i32.lt_u (local.get $s) (i32.const 4))))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br_if $passes (i32.lt_u (local.get $r) (local.get $t))))
    ;; C = XOR of the last block of every lane; tag = H'^T(C).
    (memory.copy (i32.const 7168) (call $blk (i32.sub (local.get $q) (i32.const 1))) (i32.const 1024))
    (local.set $l (i32.const 1))
    (block $xored (loop $xor
      (br_if $xored (i32.ge_u (local.get $l) (local.get $p)))
      (local.set $b (call $blk (i32.sub (i32.mul (i32.add (local.get $l) (i32.const 1)) (local.get $q)) (i32.const 1))))
      (local.set $o (i32.const 0))
      (loop $words
        (i64.store offset=7168 (local.get $o)
          (i64.xor (i64.load offset=7168 (local.get $o)) (i64.load (i32.add (local.get $b) (local.get $o)))))
        (local.set $o (i32.add (local.get $o) (i32.const 8)))
        (br_if $words (i32.lt_u (local.get $o) (i32.const 1024))))
      (local.set $l (i32.add (local.get $l) (i32.const 1)))
      (br $xor)))
    (call $hprime (i32.const 7168) (i32.const 1024) (i32.const 8192) (local.get $T)))
)
