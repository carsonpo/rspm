(module
  (memory (export "memory") 1)
  (data (i32.const 320) "\00\08\10\18\20\28\30\38\40\48\50\58\60\68\70\78\70\50\20\40\48\78\68\30\08\60\00\10\58\38\28\18\58\40\60\00\28\10\78\68\50\70\18\30\38\08\48\20\38\48\18\08\68\60\58\70\10\30\28\50\20\00\78\40\48\00\28\38\10\20\50\78\70\08\58\60\30\40\18\68\10\60\30\50\00\58\40\18\20\68\38\28\78\70\08\48\60\28\08\78\70\68\20\50\00\38\30\18\48\10\40\58\68\58\38\70\60\08\18\48\28\00\78\20\40\30\10\50\30\78\70\48\58\18\00\40\60\10\68\38\08\20\50\28\50\10\40\20\38\30\08\28\78\58\48\70\18\60\68\00\00\08\10\18\20\28\30\38\40\48\50\58\60\68\70\78\70\50\20\40\48\78\68\30\08\60\00\10\58\38\28\18")

  (global $t (mut i64) (i64.const 0))        ;; BLAKE2b byte counter (inputs < 2^64)
  (global $buflen (mut i32) (i32.const 0))   ;; bytes in the message buffer
  (global $outlen (mut i32) (i32.const 64))  ;; digest length for this hash

  ;; ── BLAKE2b ──────────────────────────────────────────────────────────────

  ;; BLAKE2b compression F (RFC 7693 §3.2) of the 128-byte buffer at 64 into h at 0.
  (func $b2_compress (param $last i32)
    (local $v0 i64) (local $v1 i64) (local $v2 i64) (local $v3 i64) (local $v4 i64) (local $v5 i64) (local $v6 i64) (local $v7 i64) (local $v8 i64) (local $v9 i64) (local $v10 i64) (local $v11 i64) (local $v12 i64) (local $v13 i64) (local $v14 i64) (local $v15 i64) (local $s i32)
