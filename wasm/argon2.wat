  ;; Starts a hash with digest length $outlen (1..64) and optional key (≤ 64 B).
  (func $b2_init (export "b2_init") (param $outlen i32) (param $key i32) (param $keylen i32)
    (i64.store offset=0 (i32.const 0)
      (i64.xor (i64.const 0x6a09e667f3bcc908)
        (i64.extend_i32_u (i32.or (i32.const 0x01010000)
          (i32.or (i32.shl (local.get $keylen) (i32.const 8)) (local.get $outlen))))))
    (i64.store offset=8 (i32.const 0) (i64.const 0xbb67ae8584caa73b))
    (i64.store offset=16 (i32.const 0) (i64.const 0x3c6ef372fe94f82b))
    (i64.store offset=24 (i32.const 0) (i64.const 0xa54ff53a5f1d36f1))
    (i64.store offset=32 (i32.const 0) (i64.const 0x510e527fade682d1))
    (i64.store offset=40 (i32.const 0) (i64.const 0x9b05688c2b3e6c1f))
    (i64.store offset=48 (i32.const 0) (i64.const 0x1f83d9abfb41bd6b))
    (i64.store offset=56 (i32.const 0) (i64.const 0x5be0cd19137e2179))
    (global.set $t (i64.const 0))
    (global.set $buflen (i32.const 0))
    (global.set $outlen (local.get $outlen))
    (memory.fill (i32.const 64) (i32.const 0) (i32.const 128))
    ;; A key is processed as a full, zero-padded first block.
    (if (local.get $keylen) (then
      (memory.copy (i32.const 64) (local.get $key) (local.get $keylen))
