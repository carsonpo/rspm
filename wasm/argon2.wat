    (local.set $v1 (i64.load offset=8 (i32.const 0)))
    (local.set $v2 (i64.load offset=16 (i32.const 0)))
    (local.set $v3 (i64.load offset=24 (i32.const 0)))
    (local.set $v4 (i64.load offset=32 (i32.const 0)))
    (local.set $v5 (i64.load offset=40 (i32.const 0)))
    (local.set $v6 (i64.load offset=48 (i32.const 0)))
    (local.set $v7 (i64.load offset=56 (i32.const 0)))
    (local.set $v8 (i64.const 0x6a09e667f3bcc908))
    (local.set $v9 (i64.const 0xbb67ae8584caa73b))
    (local.set $v10 (i64.const 0x3c6ef372fe94f82b))
    (local.set $v11 (i64.const 0xa54ff53a5f1d36f1))
    (local.set $v12 (i64.const 0x510e527fade682d1))
    (local.set $v13 (i64.const 0x9b05688c2b3e6c1f))
    (local.set $v14 (i64.const 0x1f83d9abfb41bd6b))
    (local.set $v15 (i64.const 0x5be0cd19137e2179))
    (local.set $v12 (i64.xor (local.get $v12) (global.get $t)))
